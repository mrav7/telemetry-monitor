<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console-only logging baseline.

  Logs go to stdout so that the service behaves predictably when run from a
  terminal, under Docker and in CI. Appenders that write elsewhere are
  deliberately not configured.

  The root level is taken from TM_LOG_LEVEL, the same variable the application
  validates at startup. Reading it here rather than reconfiguring Logback from
  code keeps the level correct no matter when logging is first initialised, and
  avoids compiling application code against the SLF4J binding. Values Logback
  would otherwise accept but the service does not, such as ALL and OFF, are
  rejected during configuration validation, so the process never runs with them.
-->
<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="${TM_LOG_LEVEL:-INFO}">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
